{
  "name": "ai-resume-screener-api",
  "version": "1.0.0",
  "description": "A backend REST API that manages job postings and candidates, and uses an LLM to automatically screen resumes against a job description.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "lint": "eslint src tests",
    "migrate": "node src/db/migrate.js"
  },
  "keywords": [
    "nodejs",
    "express",
    "postgresql",
    "rest-api",
    "llm",
    "ai",
    "resume-screening"
  ],
  "author": "Tanmay Sai Gupta",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "groq-sdk": "^0.7.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
